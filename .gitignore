.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
!.env.example
*.pem
*.key
*.token
credentials.json
secrets.json
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Local data, outputs, and private plans stay ignored.
/derived_data
/data/
/runs/

# Docs are private by default; allow only the two shared agent guides.
/docs/*
!/docs/agents/
/docs/agents/*
!/docs/agents/issue-tracker.md
!/docs/agents/triage-labels.md

# Scratch plans are private by default; allow only Kairos AI planning files.
/.scratch/*
!/.scratch/kairos-ai/
