[Unit]
Description=Kairos evening data and picks job

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 __KAIROS_REPO_ROOT__/scripts/kairos_jobs.py evening-build-picks
WorkingDirectory=__KAIROS_REPO_ROOT__
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=KAIROS_JOB_LOCK=%t/kairos-jobs.lock
UMask=0077
TimeoutStartSec=20min
NoNewPrivileges=yes
